[
  {
    "id": "n-2026-04-10-1",
    "date": "2026-04-10",
    "cat": "general",
    "title_en": "Parent–Teacher Meeting for Classes 6–10",
    "title_np": "कक्षा ६–१० को अभिभावक–शिक्षक भेटघाट",
    "excerpt_en": "All parents of Classes 6–10 are requested to attend the PTM on Saturday at 10:00 AM in the main hall.",
    "excerpt_np": "कक्षा ६–१० का सबै अभिभावकहरूलाई शनिबार बिहान १०:०० बजे मुख्य हलमा हुने भेटघाटमा उपस्थित हुन अनुरोध छ।"
  },
  {
    "id": "n-2026-04-02-1",
    "date": "2026-04-02",
    "cat": "holiday",
    "title_en": "Dashain & Tihar Holiday Notice",
    "title_np": "दशैं र तिहार बिदा सूचना",
    "excerpt_en": "The school will remain closed for the festive season. Classes resume as per the academic calendar.",
    "excerpt_np": "चाडपर्वको अवसरमा विद्यालय बन्द रहनेछ। शैक्षिक पात्रो अनुसार कक्षा सञ्चालन हुनेछ।"
  },
  {
    "id": "n-2026-03-28-1",
    "date": "2026-03-28",
    "cat": "event",
    "title_en": "Science Exhibition 2082 — Open to All",
    "title_np": "विज्ञान प्रदर्शनी २०८२ — सबैका लागि खुला",
    "excerpt_en": "Students from Classes 5–10 will display working models. Parents and community members are warmly invited.",
    "excerpt_np": "कक्षा ५–१० का विद्यार्थीहरूले कार्यशील मोडेल प्रदर्शन गर्नेछन्। अभिभावक र समुदायका सदस्यहरूलाई हार्दिक निमन्त्रणा।"
  },
  {
    "id": "n-2026-03-21-1",
    "date": "2026-03-21",
    "cat": "event",
    "title_en": "Annual Sports Day 2082 — All Parents Invited",
    "title_np": "वार्षिक खेलकुद दिवस २०८२ — सबै अभिभावकलाई निमन्त्रणा",
    "excerpt_en": "Join us for a full day of athletics, football, volleyball and cultural performances by our students.",
    "excerpt_np": "एथलेटिक्स, फुटबल, भलिबल र विद्यार्थीहरूको सांस्कृतिक प्रस्तुतिका साथ दिनभरको कार्यक्रममा सहभागी हुनुहोस्।"
  },
  {
    "id": "n-2026-03-15-1",
    "date": "2026-03-15",
    "cat": "general",
    "title_en": "New Library Books Arrived",
    "title_np": "पुस्तकालयमा नयाँ पुस्तकहरू आइपुगे",
    "excerpt_en": "Over 250 new titles in English and Nepali are now available. Students may borrow up to two books at a time.",
    "excerpt_np": "अङ्ग्रेजी र नेपालीमा २५० भन्दा बढी नयाँ पुस्तकहरू उपलब्ध छन्। विद्यार्थीहरूले एक पटकमा दुई पुस्तक लिन सक्नेछन्।"
  },
  {
    "id": "n-2026-03-05-1",
    "date": "2026-03-05",
    "cat": "general",
    "title_en": "Admissions Open for Academic Session 2082/83",
    "title_np": "शैक्षिक सत्र २०८२/८३ को भर्ना खुला",
    "excerpt_en": "Applications are open for Nursery to Class 10. Limited seats available — apply early to secure your child's place.",
    "excerpt_np": "नर्सरीदेखि कक्षा १० सम्म आवेदन खुला छ। सीमित सिट — चाँडै आवेदन गर्नुहोस्।"
  },
  {
    "id": "n-1790838808064",
    "date": "2026-09-29",
    "category": "exam",
    "title_en": "2nd Terminal Examination",
    "title_np": "दोस्रो त्रैमासिक परीक्षा २०८३",
    "message_en": "Student's fee must be cleared by 18th Ashoj in order to receive the Admit Card; otherwise students are not allowed to take the exam. School will be closed from 31st Ashoj to 8th Kartik 2083, and school will reopen on 9th Kartik. Results will be published on 13th Kartik.\n\nNote: Classes Nine and Ten have their exams at 7:00 AM. All other classes (P.G. through Eight) have their exams at 10:00 AM.",
    "message_np": "परीक्षामा सहभागी हुनका लागि विद्यार्थीहरूले असोज १८ गतेभित्र शुल्क बुझाउनु पर्नेछ, अन्यथा प्रवेश पत्र प्राप्त गर्न सकिने छैन। विद्यालय असोज ३१ गतेदेखि कार्तिक ८ गतेसम्म बन्द रहनेछ र कार्तिक ९ गतेबाट पुनः खुल्नेछ। नतिजा कार्तिक १३ गते प्रकाशित हुनेछ।\n\nनोट: कक्षा ९ र १० को परीक्षा बिहान ७:०० बजे हुनेछ। अन्य सबै कक्षा (P.G. देखि आठ सम्म) को परीक्षा बिहान १०:०० बजे हुनेछ।",
